<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/black">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/black"
        app:titleTextColor="@color/white"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        app:navigationIcon="@drawable/ic_back_white">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Editor"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_gravity="center" />

    </androidx.appcompat.widget.Toolbar>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        app:endIconMode="clear_text"
        app:endIconTint="@color/gray">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/titleEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Note Title"
            android:textColor="@color/white"
            android:textColorHint="@color/gray"
            android:textSize="18sp"
            android:textStyle="bold"
            android:inputType="textCapWords" />

    </com.google.android.material.textfield.TextInputLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/dark_gray"
        android:padding="8dp"
        android:layout_marginTop="8dp"
        android:scrollbars="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btnH1"
                    style="@style/ToolbarButtonLarge"
                    android:text="H1"
                    android:textSize="13sp" />
                <Button
                    android:id="@+id/btnH2"
                    style="@style/ToolbarButtonLarge"
                    android:text="H2"
                    android:textSize="13sp" />
                <Button
                    android:id="@+id/btnH3"
                    style="@style/ToolbarButtonLarge"
                    android:text="H3"
                    android:textSize="13sp" />

            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@color/gray" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btnBold"
                    style="@style/ToolbarButtonLarge"
                    android:text="B"
                    android:textStyle="bold"
                    android:textSize="16sp" />
                <Button
                    android:id="@+id/btnItalic"
                    style="@style/ToolbarButtonLarge"
                    android:text="I"
                    android:textStyle="italic"
                    android:textSize="16sp" />
                <Button
                    android:id="@+id/btnUnderline"
                    style="@style/ToolbarButtonLarge"
                    android:text="U"
                    android:textSize="16sp" />
                <Button
                    android:id="@+id/btnStrikethrough"
                    style="@style/ToolbarButtonLarge"
                    android:text="S"
                    android:textSize="16sp" />

            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@color/gray" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btnBulletList"
                    style="@style/ToolbarButtonLarge"
                    android:text="•"
                    android:textSize="22sp" />
                <Button
                    android:id="@+id/btnNumberedList"
                    style="@style/ToolbarButtonLarge"
                    android:text="1."
                    android:textSize="15sp" />
                <Button
                    android:id="@+id/btnCheckboxList"
                    style="@style/ToolbarButtonLarge"
                    android:text="☐"
                    android:textSize="18sp" />

            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@color/gray" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btnQuote"
                    style="@style/ToolbarButtonLarge"
                    android:text="“"
                    android:textSize="22sp" />
                <Button
                    android:id="@+id/btnCode"
                    style="@style/ToolbarButtonLarge"
                    android:text="{}"
                    android:textSize="14sp" />
                <Button
                    android:id="@+id/btnCodeBlock"
                    style="@style/ToolbarButtonLarge"
                    android:text="```"
                    android:textSize="13sp" />

            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@color/gray" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btnLink"
                    style="@style/ToolbarButtonLarge"
                    android:text="🔗"
                    android:textSize="20sp" />
                <Button
                    android:id="@+id/btnImage"
                    style="@style/ToolbarButtonLarge"
                    android:text="🖼"
                    android:textSize="20sp" />

            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@color/gray" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btnTable"
                    style="@style/ToolbarButtonLarge"
                    android:text="▦"
                    android:textSize="20sp" />
                <Button
                    android:id="@+id/btnHorizontalRule"
                    style="@style/ToolbarButtonLarge"
                    android:text="—"
                    android:textSize="22sp" />

            </LinearLayout>

        </LinearLayout>

    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/orange_dark">

        <Button
            android:id="@+id/btnTogglePreview"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:text="Show Preview"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/gray" />

        <Button
            android:id="@+id/btnToggleWrap"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:text="Wrap"
            android:textColor="@color/white"
            android:textSize="14sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/editText"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/black"
            android:gravity="top|start"
            android:hint="Write your note in Markdown..."
            android:inputType="textMultiLine"
            android:padding="16dp"
            android:textColor="@color/white"
            android:textColorHint="@color/gray"
            android:textSize="16sp"
            android:lineSpacingExtra="6dp"
            android:fontFamily="monospace"
            android:scrollbars="vertical" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/dark_gray" />

        <ScrollView
            android:id="@+id/previewScrollView"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/black"
            android:visibility="gone"
            android:padding="16dp">

            <TextView
                android:id="@+id/previewText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:lineSpacingExtra="6dp" />

        </ScrollView>

    </LinearLayout>

    <Button
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:backgroundTint="@color/orange"
        android:text="@string/save_note"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>