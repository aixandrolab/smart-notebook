    <string name="how_to_use_smart_notebook">📖 How to Use Smart Notebook</string>
    <string name="quick_guide">⚡ Quick Guide</string>
    <string name="_1_creating_notes">1. 📝 Creating Notes</string>
    <string name="tap_the_button_to_create_a_new_note_nenter_a_title_and_content_then_tap_save">Tap the + button to create a new note.\nEnter a title and content, then tap Save.</string>
    <string name="_2_voice_input">2. 🎤 Voice Input</string>
    <string name="tap_the_microphone_icon_next_to_the_input_field_nspeak_your_text_and_it_will_be_automatically_inserted">Tap the microphone icon next to the input field.\nSpeak your text and it will be automatically inserted.</string>
    <string name="_3_drag_amp_drop_sorting"><![CDATA[3. 🔄 Drag & Drop Sorting]]></string>
    <string name="long_press_and_drag_the_handle_to_reorder_notes_nyour_custom_order_is_automatically_saved">Long press and drag the handle (≡) to reorder notes.\nYour custom order is automatically saved.</string>
    <string name="_4_viewing_notes">4. 👁️ Viewing Notes</string>
    <string name="tap_the_eye_icon_or_the_note_title_to_open_and_view_full_details">Tap the eye icon or the note title to open and view full details.</string>
    <string name="_5_adding_attachments">5. 🖼️ Adding Attachments</string>
    <string name="in_note_details_tap_attach_to_add_n_photos_from_camera_gallery_n_any_files_pdf_doc_txt_etc">In note details, tap \'Attach\' to add:\n• Photos from camera/gallery\n• Any files (PDF, DOC, TXT, etc.)</string>
    <string name="_6_setting_reminders">6. ⏰ Setting Reminders</string>
    <string name="tap_reminder_to_set_a_date_and_time_for_notification_nnotifications_work_even_when_the_app_is_closed">Tap \'Reminder\' to set a date and time for notification.\nNotifications work even when the app is closed.</string>
    <string name="_7_editing_notes">7. ✏️ Editing Notes</string>
    <string name="tap_edit_in_note_details_to_modify_title_or_content_nyou_can_also_use_voice_input_while_editing">Tap \'Edit\' in note details to modify title or content.\nYou can also use voice input while editing.</string>
    <string name="_8_deleting_notes">8. 🗑️ Deleting Notes</string>
    <string name="tap_delete_note_in_note_details_to_permanently_remove_it_nor_swipe_left_right_on_the_main_screen_and_confirm">Tap \'Delete Note\' in note details to permanently remove it.\nOr swipe left/right on the main screen and confirm.</string>
    <string name="_9_managing_attachments">9. 📎 Managing Attachments</string>
    <string name="tap_image_file_to_view_open_it_n_long_press_on_image_file_to_delete_it">• Tap image/file to view/open it\n• Long press on image/file to delete it</string>
    <string name="tips">💡 Tips</string>
    <string name="all_data_is_stored_locally_in_documents_smart_notebook">• All data is stored locally in Documents/smart-notebook/</string>
